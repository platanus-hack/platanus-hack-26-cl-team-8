# Prompt Arena — variables de entorno.
#
#   cp .env.example .env
#
# Docker Compose lee `.env` para rellenar docker-compose.yml. Todas las variables
# tienen valor por defecto: con este archivo tal cual, el stack corre en modo "mock"
# (sin claves de LLM). La fuente de verdad de las variables del servidor es
# libs/env/src/index.ts.
#
# Dentro de Docker, los hosts y puertos internos los FIJA docker-compose.yml
# (MC_HOST=minecraft, RCON_HOST=minecraft, MC_PORT=25565, RCON_PORT=25575,
# ORCHESTRATOR_PORT=8787, DATA_DIR=/data, RTMP_URL=rtmp://mediamtx:1935/live/arena).
#
# Desarrollo local (pnpm dev, fuera de Docker): el orquestador también lee este
# archivo al arrancar. Las líneas comentadas "Solo fuera de Docker" muestran los
# valores por defecto (localhost); no hace falta descomentarlas.

# ---------- Minecraft ----------
# Versión de Java Edition (servidor Paper y protocolo de los bots).
MC_VERSION=1.20.4
# Contraseña de RCON. Cámbiala: el orquestador controla el servidor con ella.
RCON_PASSWORD=phack-rcon
# Mapa (escenario de arena) de las peleas. Hoy hay uno solo en juego, "platanus": déjalo así.
#   platanus       = el orquestador construye por RCON, en el mundo vacío "arena", una
#                    plataforma lisa de 23x23 con el logo de Platanus al centro, rodeada
#                    por muros de vidrio y abierta arriba (por defecto).
#   chunk-battle   = dos islas flotantes del mapa "Chunk Battle" (datapack
#                    infra/minecraft/datapacks/phack-chunkbattle). Sin uso: ni la web ni
#                    el torneo lo ofrecen.
#   pizza-spleef-2 = mapa importado de infra/minecraft/worlds/pizza-spleef-2.zip, con su
#                    propio mundo. Sin uso.
# Lo leen el servidor (docker-compose y scripts/local/minecraft.sh: decide el mundo, "arena"
# o "pizza-spleef-2"), el orquestador y la cámara.
ARENA_SCENARIO=platanus
# Heap de la JVM del servidor de Minecraft (solo docker-compose).
MC_MEMORY=2G
# Solo fuera de Docker:
# MC_HOST=127.0.0.1
# MC_PORT=25565
# RCON_HOST=127.0.0.1
# RCON_PORT=25575

# ---------- LLM ----------
# mock | vercel
# "vercel" = Vercel AI Gateway (SDK `ai`): una sola clave para modelos de muchos
# creadores, con id "creador/modelo" (por ejemplo anthropic/claude-haiku-5.5).
# "mock" no llama a ninguna API: sirve para probar toda la cadena sin gastar nada.
# No hay más valores: con cualquier otro (openai, anthropic, openrouter, gateway)
# el orquestador y la cámara no arrancan.
LLM_PROVIDER=mock
# Vacío = modelo por defecto del proveedor (definido en packages/llm).
# Con "vercel" el id es "creador/modelo", p. ej. deepseek/deepseek-v4.1-flash-1017-fast
# Es el modelo por defecto de ambos agentes y siempre está permitido. Los que se eligen
# en la web salen de GET /api/models: solo los del catálogo que cuestan como máximo
# 1 USD (entrada) y 5 USD (salida) por millón de tokens.
LLM_MODEL=
# Clave de Vercel AI Gateway. Hace falta con LLM_PROVIDER=vercel, y también con "mock"
# si alguien elige un modelo real para un agente en la web.
VERCEL_API_KEY=

# ---------- Orquestador ----------
# Duración máxima de una pelea, en segundos. Si nadie muere, gana quien tenga más vida.
MATCH_DURATION_SECONDS=180
# Tope de seguridad para las peleas sin límite de tiempo (el interruptor de la web): pasado
# este tiempo el servidor la detiene, sin ganador. 0 = sin tope.
# MATCH_MAX_SECONDS=1800
# Pausa mínima entre dos decisiones de un agente, en ms (percibir -> LLM -> actuar). Con 300
# ningún modelo queda frenado: cada uno decide en cuanto responde. Antes era 1500, que igualaba
# a todos los que responden en menos de 1,5 s.
AGENT_TICK_MS=300
# Radio horizontal del mapa que recibe cada agente; incluye toda la altura útil (8 a 64).
AGENT_OBSERVATION_RADIUS=16
# Solo fuera de Docker:
# ORCHESTRATOR_PORT=8787
# DATA_DIR=./data

# ---------- Acceso: quién puede cambiar la arena ----------
# Mirar (la transmisión, el marcador, el leaderboard) nunca pide nada. Con ADMIN_PASSPHRASE
# puesta, cambiar algo pide una clave, que el navegador guarda y manda con cada solicitud.
# Vacía = sin control: cualquiera que llegue a la API puede todo (bien para una máquina local,
# no para un sitio público).
#   Clave del equipo: todo (detener peleas, ajustes, voz, baterías, borrar el historial).
ADMIN_PASSPHRASE=
#   Clave de invitados, opcional (un jurado): escribir los prompts, elegir cómo se comunican
#   los agentes e iniciar peleas. Nada más.
PLAYER_PASSPHRASE=
# Sin clave, quien visita solo mira, salvo que el equipo encienda "Arena abierta" en los
# ajustes de la web: entonces puede lo mismo que un invitado.
# Cómo se le da la clave a un navegador:
#   - Con un enlace (sirve para un QR): https://tu-sitio/#key=LA_CLAVE. La página la guarda
#     y la borra de la dirección; lo que va tras el "#" no llega al servidor.
#   - A mano, en la consola del navegador:
#       localStorage.setItem("prompt-arena.access", JSON.stringify({ key: "LA_CLAVE" }))
# Usa claves largas y sin espacios ni símbolos raros (letras, números y guiones).

# ---------- Voz de los agentes (ElevenLabs) ----------
# En el modo de comunicación "chat", lo que un agente le dice al otro también se oye, con
# una voz por lado. Se enciende en la web, con los demás ajustes de la pelea; sin la clave
# o sin las dos voces el interruptor no hace nada y los mensajes solo se leen.
# Clave de la API de ElevenLabs (Perfil -> API Keys). Va solo en el .env del servidor.
# Si la clave es restringida, necesita Text to Speech y lectura de "User" (User: Read):
# sin esta última la voz anda, pero el tope VOICE_MIN_CREDITS_LEFT no se puede aplicar.
ELEVENLABS_API_KEY=
# Id de la voz de cada lado: en la app de ElevenLabs, abre la voz (Voices) y copia su
# "Voice ID" (en su página o en el menú de la voz). Sin las dos, no hay voz.
ELEVENLABS_VOICE_RED=
ELEVENLABS_VOICE_BLUE=
# Voces japonesas: un segundo par, que se elige en la web junto al interruptor de la voz
# ("Voces: habituales o japonesas"). Vienen puestas; solo hace falta esto para cambiarlas.
# ELEVENLABS_VOICE_JAPANESE_RED=jyogAI7BN5DyoykAgSk6
# ELEVENLABS_VOICE_JAPANESE_BLUE=nkmkwBCNHgzLGGnbmMTD
# Modelo. eleven_flash_v2_5 es el rápido (~100 ms) y habla español.
# ELEVENLABS_MODEL=eleven_flash_v2_5
# Velocidad del habla, de 0.7 a 1.2 (1.0 = normal). Un poco rápida acompaña mejor la pelea.
# ELEVENLABS_SPEED=1.1
# Formato del audio. Más calidad (mp3_44100_128, mp3_44100_192) tarda un poco más.
# ELEVENLABS_OUTPUT_FORMAT=mp3_44100_64
# Idioma, en código de dos letras (es, en...). Vacío = lo detecta el modelo: cada agente
# habla en el idioma que elige.
# ELEVENLABS_LANGUAGE=
# Largo máximo, en caracteres, de lo que se lee en voz alta (se corta en una palabra; el
# mensaje escrito no cambia).
# VOICE_MAX_CHARS=300
# Con menos créditos que esto en la cuenta, los agentes dejan de hablar (se lee cada 10 min).
# VOICE_MIN_CREDITS_LEFT=5000

# ---------- Cámara ----------
# Quién dibuja el video:
#   client = el cliente REAL de Minecraft, capturado en el servidor (infra/stream). Es el
#            método oficial; necesita GPU NVIDIA y `sudo bash infra/stream/install.sh`.
#   viewer = render propio por software (prismarine-viewer). Sin GPU; se ve más simple.
# Con Docker Compose el valor por defecto es client (en desarrollo local, viewer).
# CAMERA_MODE=client
# Nombre del bot cámara. En modo client no dibuja: vuela, y el cliente real ve lo que él ve.
CAMERA_USERNAME=Camara
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
CAMERA_FPS=30
# Segundos por vuelta de la órbita alrededor de la arena. 0 = cámara fija.
CAMERA_ORBIT_SECONDS=0
# Radio de chunks que dibuja la cámara (2 a 12). Bájalo a 3 si el render consume mucha CPU.
CAMERA_VIEW_DISTANCE=4
# Bitrate del video en kbps. (Modo client: si no se define, usa 4500.)
CAMERA_BITRATE_KBPS=2500
# 1 = agrega una pista de audio en silencio (por si el reproductor HLS no parte sin audio).
CAMERA_SILENT_AUDIO=
# Solo fuera de Docker:
# RTMP_URL=rtmp://localhost:1935/live/arena

# ---------- Transmisión con el cliente real (CAMERA_MODE=client) ----------
# Las lee infra/stream/stream.sh en el host; la primera también el contenedor camera.
# Usuario con el que entra el cliente real de Minecraft.
# STREAM_CLIENT_USERNAME=Camarografo
# Campo de visión vertical del cliente, en grados (30 a 110). Menor = más "teleobjetivo".
# STREAM_FOV=60
# Hay dos cámaras. Sin pelea se muestra la general (estática, desde arriba). Con pelea se
# alternan: tantos segundos la que sigue a los peleadores y tantos la general.
# 0 en WIDE = nunca cortar a la general durante la pelea; 0 en FOLLOW = solo la general.
# CAMERA_FOLLOW_SECONDS=20
# CAMERA_WIDE_SECONDS=6
# 1 = se ven los títulos del juego (cuenta regresiva, ganador). 0 = sin interfaz.
# STREAM_HUD=1
# Codificador de ffmpeg: h264_nvenc (GPU NVIDIA), libopenh264 o libx264.
# STREAM_ENCODER=h264_nvenc

# ---------- Web ----------
# Puerto del servidor (host) donde queda el sitio: http://<servidor>:8080
WEB_PORT=8080
# Interfaz donde se publica ese puerto. Vacío = todas las interfaces, IPv4 e IPv6 (por
# defecto). 0.0.0.0 = todas, pero solo IPv4. 127.0.0.1 = solo el loopback del servidor.
# Con el túnel de Cloudflare usa 127.0.0.1: el sitio sale a internet solo por el túnel
# y en el servidor sigue en http://127.0.0.1:8080 (lo usa scripts/smoke.sh).
# WEB_BIND=
# Argumentos de BUILD de la web (Astro los lee con import.meta.env.PUBLIC_*).
# Cambiarlos requiere reconstruir: docker compose build web
# Base de la API. Vacío = mismo origen (lo normal detrás de Caddy).
PUBLIC_API_BASE=
# URL del playlist HLS.
PUBLIC_HLS_URL=/live/arena/index.m3u8

# ---------- Cloudflare Tunnel ----------
# Publica el sitio en tu dominio (y el SSH de los despliegues) sin abrir puertos ni usar
# Tailscale. Paso a paso: docs/CLOUDFLARE.md.
# Token del túnel: panel de Cloudflare -> Networking -> Tunnels -> tu túnel -> el valor
# largo que va después de `--token` en el comando de instalación. Es un secreto: solo va
# en el .env del servidor. Solo se usa con el perfil "tunnel":
#   docker compose --profile tunnel up -d     (o DEPLOY_TUNNEL=1 en los scripts de despliegue)
# Vacío con el perfil "tunnel" = cloudflared no arranca y se reinicia en bucle.
# Si el túnel es la única entrada, pon también WEB_BIND=127.0.0.1 (sección Web): con el
# puerto abierto a la red local, cualquiera ahí puede inventar la cabecera cf-connecting-ip
# y saltarse el límite por IP del orquestador.
TUNNEL_TOKEN=
# Transporte hacia Cloudflare: auto (QUIC por UDP 7844, con respaldo HTTP/2) o http2 (solo
# TCP 7844). Usa http2 si la red del servidor bloquea UDP de salida.
# TUNNEL_TRANSPORT_PROTOCOL=auto

# ---------- Varios ----------
TZ=America/Santiago
