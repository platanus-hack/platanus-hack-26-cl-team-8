# Arena de prompts — variables de entorno.
#
#   cp .env.example .env
#
# Docker Compose lee `.env` para rellenar docker-compose.yml. Todas las variables
# tienen valor por defecto: con este archivo tal cual, el stack corre en modo "mock"
# (sin claves de LLM). La fuente de verdad de las variables del servidor es
# libs/env/src/index.ts.
#
# Dentro de Docker, los hosts y puertos internos los FIJA docker-compose.yml
# (MC_HOST=minecraft, RCON_HOST=minecraft, MC_PORT=25565, RCON_PORT=25575,
# ORCHESTRATOR_PORT=8787, DATA_DIR=/data, RTMP_URL=rtmp://mediamtx:1935/live/arena).
#
# Desarrollo local (pnpm dev, fuera de Docker): el orquestador también lee este
# archivo al arrancar. Las líneas comentadas "Solo fuera de Docker" muestran los
# valores por defecto (localhost); no hace falta descomentarlas.

# ---------- Minecraft ----------
# Versión de Java Edition (servidor Paper y protocolo de los bots).
MC_VERSION=1.20.4
# Contraseña de RCON. Cámbiala: el orquestador controla el servidor con ella.
RCON_PASSWORD=phack-rcon
# Heap de la JVM del servidor de Minecraft (solo docker-compose).
MC_MEMORY=2G
# Solo fuera de Docker:
# MC_HOST=127.0.0.1
# MC_PORT=25565
# RCON_HOST=127.0.0.1
# RCON_PORT=25575

# ---------- LLM ----------
# mock | vercel
# "vercel" = Vercel AI Gateway (SDK `ai`): una sola clave para modelos de muchos
# creadores, con id "creador/modelo" (por ejemplo anthropic/claude-haiku-5.5).
# "mock" no llama a ninguna API: sirve para probar toda la cadena sin gastar nada.
# No hay más valores: con cualquier otro (openai, anthropic, openrouter, gateway)
# el orquestador y la cámara no arrancan.
LLM_PROVIDER=mock
# Vacío = modelo por defecto del proveedor (definido en packages/llm).
# Con "vercel" el id es "creador/modelo", p. ej. deepseek/deepseek-v4.1-flash-1017-fast
# Es el modelo por defecto de ambos agentes y siempre está permitido. Los que se eligen
# en la web salen de GET /api/models: solo los del catálogo que cuestan como máximo
# 1 USD (entrada) y 5 USD (salida) por millón de tokens.
LLM_MODEL=
# Clave de Vercel AI Gateway. Hace falta con LLM_PROVIDER=vercel, y también con "mock"
# si alguien elige un modelo real para un agente en la web.
VERCEL_API_KEY=

# ---------- Orquestador ----------
# Duración máxima de una pelea, en segundos. Si nadie muere, gana quien tenga más vida.
MATCH_DURATION_SECONDS=180
# Tope de seguridad para las peleas sin límite de tiempo (el interruptor de la web): pasado
# este tiempo el servidor la detiene, sin ganador. 0 = sin tope.
# MATCH_MAX_SECONDS=1800
# Cada cuántos milisegundos decide cada agente (percibir -> LLM -> actuar).
AGENT_TICK_MS=1500
# Radio horizontal del mapa que recibe cada agente; incluye toda la altura útil (8 a 64).
AGENT_OBSERVATION_RADIUS=16
# Solo fuera de Docker:
# ORCHESTRATOR_PORT=8787
# DATA_DIR=./data

# ---------- Cámara ----------
# Quién dibuja el video:
#   client = el cliente REAL de Minecraft, capturado en el servidor (infra/stream). Es el
#            método oficial; necesita GPU NVIDIA y `sudo bash infra/stream/install.sh`.
#   viewer = render propio por software (prismarine-viewer). Sin GPU; se ve más simple.
# Con Docker Compose el valor por defecto es client (en desarrollo local, viewer).
# CAMERA_MODE=client
# Nombre del bot cámara. En modo client no dibuja: vuela, y el cliente real ve lo que él ve.
CAMERA_USERNAME=Camara
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
CAMERA_FPS=30
# Segundos por vuelta de la órbita alrededor de la arena. 0 = cámara fija.
CAMERA_ORBIT_SECONDS=0
# Radio de chunks que dibuja la cámara (2 a 12). Bájalo a 3 si el render consume mucha CPU.
CAMERA_VIEW_DISTANCE=4
# Bitrate del video en kbps. (Modo client: si no se define, usa 4500.)
CAMERA_BITRATE_KBPS=2500
# 1 = agrega una pista de audio en silencio (por si el reproductor HLS no parte sin audio).
CAMERA_SILENT_AUDIO=
# Solo fuera de Docker:
# RTMP_URL=rtmp://localhost:1935/live/arena

# ---------- Transmisión con el cliente real (CAMERA_MODE=client) ----------
# Las lee infra/stream/stream.sh en el host; la primera también el contenedor camera.
# Usuario con el que entra el cliente real de Minecraft.
# STREAM_CLIENT_USERNAME=Camarografo
# Campo de visión vertical del cliente, en grados (30 a 110). Menor = más "teleobjetivo".
# STREAM_FOV=60
# Hay dos cámaras. Sin pelea se muestra la general (estática, desde arriba). Con pelea se
# alternan: tantos segundos la que sigue a los peleadores y tantos la general.
# 0 en WIDE = nunca cortar a la general durante la pelea; 0 en FOLLOW = solo la general.
# CAMERA_FOLLOW_SECONDS=20
# CAMERA_WIDE_SECONDS=6
# 1 = se ven los títulos del juego (cuenta regresiva, ganador). 0 = sin interfaz.
# STREAM_HUD=1
# Codificador de ffmpeg: h264_nvenc (GPU NVIDIA), libopenh264 o libx264.
# STREAM_ENCODER=h264_nvenc

# ---------- Web ----------
# Puerto del servidor (host) donde queda el sitio: http://<servidor>:8080
WEB_PORT=8080
# Argumentos de BUILD de la web (Astro los lee con import.meta.env.PUBLIC_*).
# Cambiarlos requiere reconstruir: docker compose build web
# Base de la API. Vacío = mismo origen (lo normal detrás de Caddy).
PUBLIC_API_BASE=
# URL del playlist HLS.
PUBLIC_HLS_URL=/live/arena/index.m3u8

# ---------- Cloudflare Tunnel ----------
# Token del túnel (Zero Trust -> Networks -> Tunnels). Solo se usa con el perfil "tunnel":
#   docker compose --profile tunnel up -d
TUNNEL_TOKEN=

# ---------- Varios ----------
TZ=America/Santiago
