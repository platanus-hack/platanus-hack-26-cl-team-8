---
// Tipografías servidas por el propio sitio (sin pedirlas a un CDN).
import "@fontsource-variable/instrument-sans";
import "@fontsource/silkscreen/400.css";
import {
  COMMS_LABELS,
  COMMS_MODES,
  DEFAULT_COMMS,
  DEFAULT_KIT,
  KITS,
  KIT_LIST,
  MAX_HEALTH,
  TIMER_LABELS,
  VOICE_LABELS,
  DEFAULT_SCENARIO,
  HORIZONS,
  MAX_ROUNDS,
  RULE_IDS,
  RULE_LABELS,
  SCENARIOS,
  SCENARIO_IDS,
  SERIES_WINS,
  SERIES_WIN_LABELS,
} from "@phack/protocol";
import HeartSprite from "../components/HeartSprite.astro";
import PixelIcon from "../components/PixelIcon.astro";
import "../styles/global.css";

// Los ids generados aquí (fighter-red, prompt-blue, ...) son el contrato con
// src/scripts/*.ts. Todo el contenido dinámico se escribe con textContent.
// Un corazón por cada 2 puntos de vida.
const hearts = Array.from({ length: Math.ceil(MAX_HEALTH / 2) });

const sides = [
  { id: "red", label: "Rojo", bot: "AgenteRojo" },
  { id: "blue", label: "Azul", bot: "AgenteAzul" },
] as const;

// Estadísticas de cada agente, bajo su barra de vida: un ícono de píxeles y su número.
// `tip` es el texto de ayuda que aparece al pasar el mouse (ver "Ayuda al pasar el mouse"
// en global.css); `label` es el nombre para lectores de pantalla.
const stats = [
  { id: "food", icon: "food", label: "Comida", tip: "Comida, de 0 a 20. Con la barra alta el agente recupera vida solo; comer la repone." },
  { id: "damage", icon: "sword", label: "Daño hecho", tip: "Daño que este agente le ha hecho al rival en esta pelea." },
  { id: "decisions", icon: "decisions", label: "Decisiones", tip: "Decisiones: cuántas veces el modelo eligió qué hacer." },
  { id: "speed", icon: "clock", label: "Tiempo por decisión", tip: "Lo que tarda el modelo en decidir, en promedio. Un modelo lento pierde turnos." },
  { id: "cost", icon: "emerald", label: "Costo del modelo", tip: "Lo que ha costado el modelo en esta pelea." },
] as const;

// El ítem en la mano cambia en vivo: su casillero va vacío aquí y lo dibuja
// scripts/scoreboard.ts. Lo mismo el inventario del kit de cada editor
// (scripts/inventory.ts), que cambia con el desplegable, y las columnas de pensamientos
// (scripts/thoughts.ts).
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#101113" />
    <title>Prompt Arena</title>
    <meta
      name="description"
      content="Dos agentes de IA pelean en una arena de Minecraft, cada uno guiado por un prompt. Mira la pelea en vivo, edita los prompts y descubre cuál gana."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body data-phase="unknown" data-conn="connecting">
    <!-- La transmisión ocupa toda la pantalla; el marcador y los pensamientos van encima. -->
    <section class="stage" aria-label="Pelea en vivo">
      <div class="player" id="player" data-signal="off">
        <video id="arena-video" class="player__video" muted autoplay playsinline></video>
        <div class="player__nosignal">
          <strong>Sin señal</strong>
          <p id="no-signal-detail">Esperando la transmisión de la arena. Reintentando…</p>
        </div>
      </div>

      <header class="top">
        <div class="brand">
          <span class="brand__mark" aria-hidden="true"><i></i><i></i></span>
          <h1 class="brand__title">Prompt Arena</h1>
        </div>
        <!-- Solo se ve cuando llega la transmisión (global.css lo decide por el estado del reproductor). -->
        <span class="live" role="status" data-tip="La transmisión de la arena está llegando en este momento.">
          <i class="live__dot" aria-hidden="true"></i>
          En vivo
        </span>
        <button
          type="button"
          class="sound"
          id="btn-sound"
          aria-pressed="false"
          aria-label="Sonido"
          data-tip="Sonido apagado. Haz clic para oír los golpes y la campana."
        >
          <span data-sound="on"><PixelIcon name="sound-on" /></span>
          <span data-sound="off"><PixelIcon name="sound-off" /></span>
        </button>
        <div class="conn" id="conn" data-state="connecting" role="status">
          <span class="conn__dot" aria-hidden="true"></span>
          <span class="conn__text" id="conn-text">Conectando…</span>
        </div>
      </header>

      <!-- Marcador: una barra de vida por lado y el reloj al centro. -->
      <div class="hud">
        {
          sides.map((side) => (
            <div class={`hud__side hud__side--${side.id}`} id={`fighter-${side.id}`} data-side={side.id}>
              <div class="hud__row">
                <h2 class="hud__name">{side.label}</h2>
                <span class="model-tag hud__model" id={`fighter-model-${side.id}`} hidden />
                <span class="hud__state" id={`fighter-state-${side.id}`} data-state="off">Desconectado</span>
                <span class="hud__hp" id={`hp-value-${side.id}`} data-tip={`Vida, de 0 a ${MAX_HEALTH}: cada corazón son 2 puntos.`}>
                –
              </span>
              </div>
              <!-- Vida en corazones, con el mismo dibujo del juego: cada uno son 2 puntos. scoreboard.ts recorta el rojo. -->
              <div
                class="hearts"
                id={`hp-${side.id}`}
                role="meter"
                aria-label={`Vida de ${side.label}`}
                aria-valuemin="0"
                aria-valuemax={MAX_HEALTH}
                aria-valuenow="0"
                data-level="ok"
              >
                {
                  hearts.map(() => (
                    <span class="heart">
                      <HeartSprite kind="container" />
                      <span class="heart__fill">
                        <HeartSprite kind="full" />
                      </span>
                    </span>
                  ))
                }
              </div>
              <dl class="stats">
                <div class="slot" id={`held-${side.id}`} data-tip="En la mano: nada.">
                  <dt class="sr-only">En la mano</dt>
                  <dd>
                    <span class="slot__icon" id={`held-icon-${side.id}`} />
                    <span class="sr-only" id={`held-name-${side.id}`}>nada</span>
                  </dd>
                </div>
                {
                  stats.map((stat) => (
                    <div data-tip={stat.tip} id={`stat-${stat.id}-${side.id}`}>
                      <dt>
                        <PixelIcon name={stat.icon} />
                        <span class="sr-only">{stat.label}</span>
                      </dt>
                      <dd id={`${stat.id}-${side.id}`}>–</dd>
                    </div>
                  ))
                }
              </dl>
              <span class="sr-only" id={`bot-${side.id}`}>{side.bot}</span>
            </div>
          ))
        }
        <div class="hud__clock">
          <div class="clock" id="clock" aria-label="Tiempo restante" data-tip="Tiempo que le queda a la pelea. Si se acaba, gana quien tenga más vida.">
            --:--
          </div>
          <span class="phase" id="phase">Conectando…</span>
          <!-- Modo por rondas: un cuadro por ronda, del color de quien la ganó (scoreboard.ts). -->
          <ol class="rounds" id="rounds" hidden></ol>
        </div>
      </div>

      <div class="winner" id="winner-banner" data-winner="none" role="status" hidden>
        <strong class="winner__title" id="winner-title"></strong>
        <span class="winner__detail" id="winner-detail"></span>
        <p class="winner__why" id="winner-why" hidden></p>
      </div>

      <!-- Cuenta regresiva antes de la pelea ("3", "2", "1", "¡Pelea!"): la escribe scripts/countdown.ts. -->
      <div class="countdown" id="countdown" data-step="count" aria-hidden="true" hidden></div>

      <!--
        Pensamientos en vivo: una columna por agente a cada lado del video, con sus últimos
        pensamientos (el más nuevo abajo) y la acción que eligió con cada uno. Las llena
        scripts/thoughts.ts. La lista cambia varias veces por segundo, así que los lectores
        de pantalla leen solo el resumen oculto de cada columna.
      -->
      <div class="thoughts">
        {
          sides.map((side) => (
            <section
              class={`thoughts__col thoughts__col--${side.id}`}
              data-side={side.id}
              aria-label={`Pensamientos de ${side.label}`}
            >
              <p class="sr-only">
                Último pensamiento: <span id={`last-thought-${side.id}`}>—</span>
              </p>
              <p class="sr-only">
                Última acción: <span id={`last-action-${side.id}`}>—</span>
              </p>
              <ol class="thoughts__list" id={`thoughts-list-${side.id}`} aria-hidden="true" />
              <div class="thoughts__thinking" id={`thinking-${side.id}`} aria-hidden="true">
                <i /><i /><i />
              </div>
            </section>
          ))
        }
      </div>

      <!-- El botón de la pelea, abajo al centro: uno solo a la vez (iniciar o detener). -->
      <div class="controls">
        <button type="button" class="btn btn--primary" id="btn-start" disabled>Iniciar pelea</button>
        <button type="button" class="btn btn--ghost" id="btn-stop" disabled>Detener</button>
      </div>
    </section>

    <main class="page">
      <div class="workbench">
        <section class="prompts" aria-labelledby="prompts-title">
        <header class="section__head">
          <h2 class="section__title" id="prompts-title">Preparar la pelea</h2>
          <p class="section__hint">
            Ajusta la partida y dile a cada agente qué quiere lograr, con qué kit y con qué modelo. Cualquiera puede
            editarlo; vale desde la próxima pelea. Los ítems que existen están en <a href="/items">la lista de ítems</a>.
          </p>
        </header>

        <!-- Ajustes de la pelea (no de un lado): los maneja scripts/settings.ts. -->
        <!--
          Ajustes de la partida: una fila por ajuste, con su nombre a la izquierda y el control
          a la derecha. La ayuda de cada uno se abre con el botón "i" junto al nombre. Los campos y sus ids son los de siempre
          (scripts/settings.ts y scripts/benchsettings.ts); controls-enhance.ts les pone el
          contador y las opciones a la vista.
        -->
        <div class="settings">
          <section class="settings__group" id="settings-field" aria-labelledby="settings-match-title">
            <h3 class="settings__title" id="settings-match-title">Partida</h3>

            <div class="setting">
              <div class="setting__text">
                <label class="setting__label" for="rounds-count"><PixelIcon name="pips" />Rondas</label>
                <p class="setting__help" id="mode-description">Una pelea suelta. Con 2 o más, una serie: cada agente sabe cómo va y puede rendirse en una ronda.</p>
              </div>
              <div class="setting__control">
                <div class="stepper" data-stepper>
                  <button type="button" class="stepper__btn" data-step="-1" aria-label="Una ronda menos">−</button>
                  <input
                    id="rounds-count"
                    class="stepper__value"
                    type="number"
                    min="1"
                    max={MAX_ROUNDS}
                    step="1"
                    value="1"
                    inputmode="numeric"
                    aria-describedby="mode-description"
                  />
                  <button type="button" class="stepper__btn" data-step="1" aria-label="Una ronda más">+</button>
                </div>
              </div>
            </div>

            <div class="setting">
              <div class="setting__text">
                <label class="setting__label" for="timer"><PixelIcon name="timer" />Límite de tiempo</label>
                <p class="setting__help" id="timer-description">{TIMER_LABELS.on}</p>
              </div>
              <div class="setting__control">
                <!-- Cuánto dura, cuando el límite está encendido: una cantidad y su unidad. -->
                <div class="duration" id="timer-duration">
                  <input
                    type="number"
                    id="timer-amount"
                    min="1"
                    step="1"
                    inputmode="numeric"
                    aria-label="Duración de la pelea"
                    aria-describedby="timer-description"
                  />
                  <select id="timer-unit" aria-label="Unidad de la duración" data-segmented>
                    <option value="60">min</option>
                    <option value="3600">horas</option>
                  </select>
                </div>
                <label class="toggle">
                  <span class="sr-only" id="timer-state">Encendido</span>
                  <input type="checkbox" role="switch" id="timer" aria-describedby="timer-description" checked />
                  <span class="toggle__track" aria-hidden="true"><i></i></span>
                </label>
              </div>
            </div>

            <div class="setting setting--wide">
              <div class="setting__text">
                <label class="setting__label" for="comms"><PixelIcon name="talk" />Comunicación entre agentes</label>
                <p class="setting__help" id="comms-description">{COMMS_LABELS[DEFAULT_COMMS].description}</p>
              </div>
              <div class="setting__control">
                <select id="comms" aria-label="Comunicación entre agentes" aria-describedby="comms-description" data-segmented>
                  {COMMS_MODES.map((mode) => <option value={mode} selected={mode === DEFAULT_COMMS}>{COMMS_LABELS[mode].name}</option>)}
                </select>
              </div>
            </div>

            <div class="setting">
              <div class="setting__text">
                <label class="setting__label" for="voice"><PixelIcon name="speaking" />Voz de los agentes</label>
                <p class="setting__help" id="voice-description">{VOICE_LABELS.off}</p>
              </div>
              <div class="setting__control">
                <label class="toggle">
                  <span class="sr-only" id="voice-state">Apagado</span>
                  <input type="checkbox" role="switch" id="voice" aria-describedby="voice-description" />
                  <span class="toggle__track" aria-hidden="true"><i></i></span>
                </label>
              </div>
            </div>
          </section>

          <!-- Benchmarks: escenario y reglas de la serie (scripts/benchsettings.ts). Ver /bench. -->
          <section class="settings__group" id="bench-settings" aria-labelledby="settings-bench-title">
            <h3 class="settings__title" id="settings-bench-title">Experimento</h3>

            <!-- Pre-ajustes: configuraciones guardadas de benchmark (scripts/presetpicker.ts). -->
            <div class="setting setting--wide" id="main-preset-field">
              <div class="setting__text">
                <label class="setting__label" for="main-preset"><PixelIcon name="bookmark" />Pre-ajuste</label>
                <p class="setting__help" id="main-preset-description"></p>
                <p class="setting__help setting__help--strong" id="main-preset-status" role="status" hidden></p>
              </div>
              <div class="setting__control setting__control--row">
                <select id="main-preset" class="select" aria-describedby="main-preset-description"></select>
                <button type="button" class="btn btn--small" id="main-preset-load">Cargar</button>
                <button type="button" class="btn btn--small preset__run" id="main-preset-run">Ejecutar</button>
                <button type="button" class="btn btn--small" id="main-preset-stop" hidden>Detener batería</button>
              </div>
            </div>

            <div class="setting">
              <div class="setting__text">
                <label class="setting__label" for="scenario"><PixelIcon name="arena" />Escenario</label>
                <p class="setting__help" id="scenario-description">{SCENARIOS[DEFAULT_SCENARIO].description}</p>
                <p class="setting__help setting__help--strong" id="scenario-hint" hidden></p>
              </div>
              <div class="setting__control">
                <select id="scenario" class="select" aria-describedby="scenario-description">
                  {SCENARIO_IDS.map((id) => <option value={id} selected={id === DEFAULT_SCENARIO}>{SCENARIOS[id].name}</option>)}
                </select>
              </div>
            </div>

            <!-- Solo con 2 rondas o más (benchsettings.ts lo muestra y lo esconde). -->
            <div class="settings__series" id="series-options">
              <div class="setting">
                <div class="setting__text">
                  <label class="setting__label" for="horizon"><PixelIcon name="eye" />Horizonte</label>
                  <p class="setting__help">Si los agentes saben cuántas rondas quedan.</p>
                </div>
                <div class="setting__control">
                  <select id="horizon" aria-label="Horizonte" aria-describedby="series-description" data-segmented>
                    {HORIZONS.map((h) => <option value={h}>{h === "known" ? "Conocido" : "Desconocido"}</option>)}
                  </select>
                </div>
              </div>
              <div class="setting">
                <div class="setting__text">
                  <label class="setting__label" for="series-win"><PixelIcon name="crown" />Gana la serie</label>
                  <p class="setting__help">Cómo se decide quién se lleva la serie.</p>
                  <p class="setting__help" id="series-description"></p>
                </div>
                <div class="setting__control">
                  <select id="series-win" aria-label="Gana la serie" aria-describedby="series-description" data-segmented>
                    {SERIES_WINS.map((w) => <option value={w}>{SERIES_WIN_LABELS[w].name}</option>)}
                  </select>
                </div>
              </div>
              <div class="setting">
                <div class="setting__text">
                  <label class="setting__label" for="refill-kit"><PixelIcon name="refill" />Reponer el kit</label>
                  <p class="setting__help">Antes de cada ronda. Si no, lo gastado no vuelve.</p>
                </div>
                <div class="setting__control">
                  <label class="toggle">
                    <input type="checkbox" role="switch" id="refill-kit" />
                    <span class="toggle__track" aria-hidden="true"><i></i></span>
                  </label>
                </div>
              </div>
            </div>

            <div class="setting">
              <div class="setting__text">
                <label class="setting__label" for="judge"><PixelIcon name="star" />Juez</label>
                <p class="setting__help" id="judge-description">
                  Al terminar la partida, un LLM lee la transcripción y califica a cada agente (necesita un LLM real).
                </p>
              </div>
              <div class="setting__control">
                <label class="toggle">
                  <span class="sr-only" id="judge-state">Apagado</span>
                  <input type="checkbox" role="switch" id="judge" aria-describedby="judge-description" />
                  <span class="toggle__track" aria-hidden="true"><i></i></span>
                </label>
              </div>
            </div>

            <!-- Espejo: una acción suelta, no un ajuste. El botón y, al lado, qué hace. -->
            <div class="settings__action">
              <button type="button" class="btn btn--small" id="btn-mirror">Copiar Rojo en Azul</button>
              <p class="setting__help">Mismo prompt, modelo y kit en los dos lados.</p>
            </div>
          </section>
        </div>

        <div class="editors">
          {
            sides.map((side) => (
              <form class={`editor editor--${side.id}`} id={`editor-${side.id}`} data-side={side.id} autocomplete="off" novalidate>
                <div class="editor__head">
                  <label class="editor__title" for={`prompt-${side.id}`}>Prompt {side.label}</label>
                  <span class="editor__count" id={`count-${side.id}`}>0 / 4000</span>
                </div>

                <textarea class="editor__text" id={`prompt-${side.id}`} rows="7" spellcheck="false"></textarea>

                <!-- Kit del lado: se guarda con el prompt. El inventario lo dibuja scripts/inventory.ts. -->
                <div class="kit">
                  <label class="field">
                    <span class="field__label">Kit</span>
                    <select id={`kit-${side.id}`} aria-describedby={`kit-description-${side.id}`}>
                      {KIT_LIST.map((kit) => <option value={kit.id} selected={kit.id === DEFAULT_KIT}>{kit.name}</option>)}
                    </select>
                  </label>
                  <p class="kit__description" id={`kit-description-${side.id}`}>{KITS[DEFAULT_KIT].description}</p>
                  <div class="inv" id={`inv-${side.id}`} role="group" aria-label="Inventario del kit" />
                </div>

                <!-- Reglas del entrenador: se guardan al marcarlas, como los ajustes (scripts/benchsettings.ts). -->
                <fieldset class="rules" id={`rules-${side.id}`} data-side={side.id}>
                  <legend class="field__label">Reglas (se cuentan las veces que las rompe)</legend>
                  {
                    RULE_IDS.map((rule) => (
                      <label class="rules__item">
                        <input type="checkbox" value={rule} data-rule={rule} />
                        {RULE_LABELS[rule].name}
                      </label>
                    ))
                  }
                </fieldset>

                <div class="editor__options">
                  <!-- Selector de modelo: lo arma scripts/modelpicker.ts con la lista de modelos permitidos. -->
                  <div class="picker" id={`picker-${side.id}`}>
                    <span class="field__label" id={`picker-label-${side.id}`}>Modelo</span>
                    <button
                      type="button"
                      class="picker__trigger"
                      id={`picker-trigger-${side.id}`}
                      aria-haspopup="listbox"
                      aria-expanded="false"
                      aria-labelledby={`picker-label-${side.id} picker-current-${side.id}`}
                    >
                      <span class="model-tag" id={`picker-current-${side.id}`} />
                    </button>
                    <div class="picker__panel" id={`picker-panel-${side.id}`} hidden>
                      <input
                        class="picker__search"
                        id={`picker-search-${side.id}`}
                        type="search"
                        placeholder="Buscar modelo"
                        aria-label="Buscar modelo"
                        autocomplete="off"
                        spellcheck="false"
                      />
                      <ul class="picker__list" id={`picker-list-${side.id}`} role="listbox" aria-label="Modelos" />
                    </div>
                  </div>
                  <button type="submit" class="btn btn--save" id={`save-${side.id}`}>Guardar</button>
                </div>

                <span class="editor__status" id={`save-status-${side.id}`} role="status"></span>

                <div class="editor__conflict" id={`conflict-${side.id}`} hidden>
                  <span>Alguien más cambió este prompt mientras escribías.</span>
                  <button type="button" class="btn btn--small" id={`reload-${side.id}`}>Cargar su versión</button>
                </div>
              </form>
            ))
          }
        </div>
      </section>

        <aside class="feed" aria-label="Eventos en vivo">
          <header class="feed__head">
            <h2 class="feed__title">Eventos</h2>
            <a
              class="feed__transcript"
              id="transcript-link"
              target="_blank"
              rel="noopener"
              data-tip="Todo lo que pasó en esta pelea, paso a paso: qué vio, pensó, dijo e hizo cada agente."
              hidden
            >
              Ver transcripción
            </a>
          </header>
          <ol class="feed__list" id="feed-list" aria-live="off">
            <li class="feed__empty">Aquí aparecerá lo que cada agente piensa, dice y hace.</li>
          </ol>
          <button type="button" class="feed__jump" id="feed-jump" hidden>Ver lo último</button>
        </aside>
      </div>
      <!-- Las últimas peleas y los prompts marcados: lo arma scripts/history.ts. -->
      <!-- Parte plegado: el historial es largo y lo de arriba (video y prompts) es lo principal. -->
      <details class="history" id="history">
        <summary class="history__toggle">
          <h2 class="section__title" id="history-title">Historial</h2>
          <span class="history__count" id="history-count"></span>
        </summary>
        <p class="section__hint history__hint">
          Las últimas peleas y los prompts que alguien marcó. Abre una pelea para ver el prompt de cada lado; márcalo para
          guardarlo con etiquetas y una nota, y después compararlo con otros o cargarlo de nuevo en un editor.
        </p>
        <div class="history__filters" id="history-filters" role="group" aria-label="Filtrar el historial"></div>
        <p class="history__summary" id="history-summary" hidden></p>
        <ol class="history__list" id="history-list"></ol>
      </details>
    </main>

    <footer class="footer">
      <p>Hecho para la Platanus Hackathon 2026, track Simulaciones. Minecraft y agentes LLM.</p>
    </footer>

    <div class="toasts" id="toasts" aria-live="assertive"></div>

    <script>
      import "../scripts/main";
    </script>
  </body>
</html>
