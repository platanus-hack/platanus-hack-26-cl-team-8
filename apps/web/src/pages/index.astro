---
// Tipografías servidas por el propio sitio (sin pedirlas a un CDN).
import "@fontsource-variable/instrument-sans";
import "@fontsource/silkscreen/400.css";
import "../styles/global.css";

// Los ids generados aquí (fighter-red, prompt-blue, ...) son el contrato con
// src/scripts/*.ts. Todo el contenido dinámico se escribe con textContent.
const sides = [
  { id: "red", label: "Rojo", bot: "AgenteRojo" },
  { id: "blue", label: "Azul", bot: "AgenteAzul" },
] as const;

const providers = [
  { value: "", label: "Por defecto del servidor" },
  { value: "mock", label: "Simulado (mock)" },
  { value: "openai", label: "OpenAI" },
  { value: "anthropic", label: "Anthropic" },
  { value: "openrouter", label: "OpenRouter" },
  { value: "gateway", label: "Vercel AI Gateway" },
] as const;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#101113" />
    <title>Arena de prompts</title>
    <meta
      name="description"
      content="Dos agentes de IA pelean en una arena de Minecraft, cada uno guiado por un prompt. Mira la pelea en vivo, edita los prompts y descubre cuál gana."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body data-phase="unknown" data-conn="connecting">
    <!-- La transmisión ocupa toda la pantalla; el marcador y los pensamientos van encima. -->
    <section class="stage" aria-label="Pelea en vivo">
      <div class="player" id="player" data-signal="off">
        <video id="arena-video" class="player__video" muted autoplay playsinline></video>
        <div class="player__nosignal">
          <strong>Sin señal</strong>
          <p id="no-signal-detail">Esperando la transmisión de la arena. Reintentando…</p>
        </div>
      </div>

      <header class="top">
        <div class="brand">
          <span class="brand__mark" aria-hidden="true"><i></i><i></i></span>
          <h1 class="brand__title">Arena de prompts</h1>
        </div>
        <span class="live" aria-hidden="true">En vivo</span>
        <div class="conn" id="conn" data-state="connecting" role="status">
          <span class="conn__dot" aria-hidden="true"></span>
          <span class="conn__text" id="conn-text">Conectando…</span>
        </div>
      </header>

      <!-- Marcador: una barra de vida por lado y el reloj al centro. -->
      <div class="hud">
        {
          sides.map((side) => (
            <div class={`hud__side hud__side--${side.id}`} id={`fighter-${side.id}`} data-side={side.id}>
              <div class="hud__row">
                <h2 class="hud__name">{side.label}</h2>
                <span class="hud__state" id={`fighter-state-${side.id}`} data-state="off">Desconectado</span>
                <span class="hud__hp" id={`hp-value-${side.id}`}>–</span>
              </div>
              <div
                class="hp"
                id={`hp-${side.id}`}
                role="meter"
                aria-label={`Vida de ${side.label}`}
                aria-valuemin="0"
                aria-valuemax="20"
                aria-valuenow="0"
                data-level="high"
              >
                <div class="hp__fill" id={`hp-fill-${side.id}`}></div>
              </div>
              <span class="sr-only" id={`bot-${side.id}`}>{side.bot}</span>
            </div>
          ))
        }
        <div class="hud__clock">
          <div class="clock" id="clock" aria-label="Tiempo restante">--:--</div>
          <span class="phase" id="phase">Conectando…</span>
        </div>
      </div>

      <div class="winner" id="winner-banner" data-winner="none" role="status" hidden>
        <strong class="winner__title" id="winner-title"></strong>
        <span class="winner__detail" id="winner-detail"></span>
      </div>

      <!-- Qué piensa cada agente ahora mismo, como subtítulos, y el botón de la pelea al centro. -->
      <div class="minds">
        {
          sides.map((side) => (
            <article class={`mind mind--${side.id}`} data-side={side.id} aria-label={`Agente ${side.label}`}>
              <span class="sr-only">Último pensamiento</span>
              <p class="mind__thought" id={`thought-${side.id}`}>—</p>
              <span class="sr-only">Última acción</span>
              <p class="mind__action" id={`action-${side.id}`}>—</p>
              <dl class="stats">
                <div>
                  <dt>Comida</dt>
                  <dd id={`food-${side.id}`}>–</dd>
                </div>
                <div>
                  <dt>Daño hecho</dt>
                  <dd id={`damage-${side.id}`}>–</dd>
                </div>
                <div>
                  <dt>Decisiones</dt>
                  <dd id={`decisions-${side.id}`}>–</dd>
                </div>
              </dl>
            </article>
          ))
        }
        <div class="controls">
          <button type="button" class="btn btn--primary" id="btn-start" disabled>Iniciar pelea</button>
          <button type="button" class="btn btn--ghost" id="btn-stop" disabled>Detener</button>
        </div>
      </div>
    </section>

    <main class="page">
      <div class="workbench">
        <section class="prompts" aria-labelledby="prompts-title">
        <header class="section__head">
          <h2 class="section__title" id="prompts-title">Prompts</h2>
          <p class="section__hint">
            Escribe cómo debe pelear cada agente. Cualquiera puede editarlos; valen desde la próxima pelea.
          </p>
        </header>

        <div class="editors">
          {
            sides.map((side) => (
              <form class={`editor editor--${side.id}`} id={`editor-${side.id}`} data-side={side.id} autocomplete="off" novalidate>
                <div class="editor__head">
                  <label class="editor__title" for={`prompt-${side.id}`}>Prompt {side.label}</label>
                  <span class="editor__count" id={`count-${side.id}`}>0 / 4000</span>
                </div>

                <textarea class="editor__text" id={`prompt-${side.id}`} rows="7" spellcheck="false"></textarea>

                <div class="editor__options">
                  <label class="field">
                    <span class="field__label">Proveedor</span>
                    <select id={`provider-${side.id}`}>
                      {providers.map((provider) => <option value={provider.value}>{provider.label}</option>)}
                    </select>
                  </label>
                  <label class="field">
                    <span class="field__label">Modelo</span>
                    <input
                      id={`model-${side.id}`}
                      type="text"
                      maxlength="100"
                      placeholder="Por defecto del servidor"
                      autocomplete="off"
                      spellcheck="false"
                    />
                  </label>
                  <button type="submit" class="btn btn--save" id={`save-${side.id}`}>Guardar</button>
                </div>

                <span class="editor__status" id={`save-status-${side.id}`} role="status"></span>

                <div class="editor__conflict" id={`conflict-${side.id}`} hidden>
                  <span>Alguien más cambió este prompt mientras escribías.</span>
                  <button type="button" class="btn btn--small" id={`reload-${side.id}`}>Cargar su versión</button>
                </div>
              </form>
            ))
          }
        </div>
      </section>

        <aside class="feed" aria-label="Eventos en vivo">
          <h2 class="feed__title">Eventos</h2>
          <ol class="feed__list" id="feed-list" aria-live="off">
            <li class="feed__empty">Aquí aparecerán los pensamientos, acciones y golpes de cada agente.</li>
          </ol>
          <button type="button" class="feed__jump" id="feed-jump" hidden>Ver lo último</button>
        </aside>
      </div>

      <section class="section" aria-labelledby="history-title">
        <header class="section__head">
          <h2 class="section__title" id="history-title">Historial</h2>
          <p class="section__hint" id="tally-summary">Cargando resultados…</p>
        </header>

        <div class="tally">
          <div class="tally__numbers">
            <div class="tally__cell tally__cell--red">
              <strong id="tally-red">0</strong>
              <span>victorias Rojo</span>
            </div>
            <div class="tally__cell tally__cell--none">
              <strong id="tally-none">0</strong>
              <span>sin ganador</span>
            </div>
            <div class="tally__cell tally__cell--blue">
              <strong id="tally-blue">0</strong>
              <span>victorias Azul</span>
            </div>
          </div>
          <div class="tally__bar" aria-hidden="true">
            <span class="tally__seg tally__seg--red" id="tally-bar-red"></span>
            <span class="tally__seg tally__seg--none" id="tally-bar-none"></span>
            <span class="tally__seg tally__seg--blue" id="tally-bar-blue"></span>
          </div>
        </div>

        <div class="history__wrap">
          <table class="history__table">
            <thead>
              <tr>
                <th scope="col">Fecha</th>
                <th scope="col">Ganador</th>
                <th scope="col">Motivo</th>
                <th scope="col">Duración</th>
                <th scope="col">Vida final</th>
                <th scope="col">Prompt Rojo</th>
                <th scope="col">Prompt Azul</th>
              </tr>
            </thead>
            <tbody id="history-body"></tbody>
          </table>
        </div>
      </section>
    </main>

    <footer class="footer">
      <p>Hecho para la Platanus Hackathon 2026, track Simulaciones. Minecraft y agentes LLM.</p>
    </footer>

    <div class="toasts" id="toasts" aria-live="assertive"></div>

    <script>
      import "../scripts/main";
    </script>
  </body>
</html>
