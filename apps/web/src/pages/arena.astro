---
// Leaderboard del torneo de modelos. Los ids de esta página son el contrato con
// src/scripts/arena/*.ts. Todo el contenido dinámico se escribe con textContent.
import "@fontsource-variable/instrument-sans";
import "@fontsource/silkscreen/400.css";
import "../styles/global.css";
import "../styles/arena.css";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#101113" />
    <title>Leaderboard de modelos</title>
    <meta
      name="description"
      content="Torneo 1v1 de agentes LLM en una arena de Minecraft: qué modelos juegan parecido a DeepSeek V4.1 Flash, su ranking y quién le gana a quién."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="arena-page">
    <header class="arena-top">
      <a class="brand arena-top__brand" href="/">
        <span class="brand__mark" aria-hidden="true"><i></i><i></i></span>
        <span class="brand__title">Arena de prompts</span>
      </a>
      <span class="arena-top__crumb" aria-hidden="true">/</span>
      <h1 class="arena-top__title">Leaderboard</h1>
      <a class="arena-top__back" href="/">Pelea en vivo</a>
    </header>

    <main class="arena">
      <div class="arena-pick">
        <label class="field arena-pick__field">
          <span class="field__label">Torneo</span>
          <select id="arena-select" disabled>
            <option>Cargando…</option>
          </select>
        </label>
        <span class="arena-pick__mock" id="arena-mock" hidden>Maqueta: datos inventados</span>
      </div>

      <p class="arena-status" id="arena-status" role="status" data-kind="info">Cargando…</p>

      <div id="arena-content" class="arena-content" hidden>
        <!-- (1) Cabecera: nombre, lectura rápida, estado y progreso del torneo. -->
        <section class="summary" aria-labelledby="t-name">
          <div class="summary__lead">
            <h2 class="summary__name" id="t-name"></h2>
            <p class="summary__take" id="t-take" hidden></p>
            <div class="summary__meta" id="t-meta"></div>
          </div>
          <aside class="provisional" id="t-provisional" hidden>
            <strong class="provisional__title">Provisional</strong>
            <ul class="provisional__why" id="t-provisional-why"></ul>
          </aside>
          <div class="summary__progress" id="t-progress"></div>
          <p class="summary__stop" id="t-stop" hidden></p>
        </section>

        <!-- (2) Tabla de posiciones: cada fila dibuja su rating y su intervalo sobre un eje común. -->
        <section class="section arena-section" aria-labelledby="standings-title">
          <header class="section__head">
            <h2 class="section__title" id="standings-title">Posiciones</h2>
            <p class="section__hint">
              Rating en escala Elo, calculado solo con las partidas válidas de la liga. La referencia está fija en 1000
              (la línea ámbar). El cuadrado es el rating de cada modelo y la línea, su intervalo: si cruza la línea
              ámbar, todavía no se distingue de la referencia.
            </p>
          </header>
          <div class="scroll-x" id="standings-table">
            <div class="axis axis--solo" id="standings-axis-solo" aria-hidden="true"></div>
            <table class="board board--cards standings">
              <thead>
                <tr>
                  <th scope="col" class="board__rank">#</th>
                  <th scope="col">Modelo</th>
                  <th scope="col" class="num">Rating</th>
                  <th scope="col" class="board__plothead">
                    <span class="sr-only">Rating e intervalo en el eje</span>
                    <div class="axis" id="standings-axis" aria-hidden="true"></div>
                  </th>
                  <th scope="col" class="num">Intervalo</th>
                  <th scope="col" class="num">Partidas</th>
                  <th scope="col"><abbr title="Victorias, empates y derrotas">V · E · D</abbr></th>
                  <th scope="col" class="num">Costo</th>
                  <th scope="col" class="num">
                    <abbr title="Latencia por decisión: mediana, y percentil 95 debajo">Latencia</abbr>
                  </th>
                </tr>
              </thead>
              <tbody id="standings-body"></tbody>
            </table>
          </div>
          <p class="board__note" id="standings-note" hidden></p>
          <p class="empty" id="standings-empty" hidden>La liga todavía no tiene partidas válidas.</p>
        </section>

        <!-- (3) Matriz fila vs columna; (4) clic en una celda abre sus partidas al lado. -->
        <section class="section arena-section" aria-labelledby="matrix-title">
          <header class="section__head">
            <h2 class="section__title" id="matrix-title">Quién le gana a quién</h2>
            <p class="section__hint">
              Puntaje de la fila contra la columna en la liga: victorias más medio punto por empate, sobre las partidas
              válidas. El número chico es cuántas partidas jugaron.
            </p>
          </header>
          <div class="h2h">
            <div class="h2h__matrix">
              <div class="legend" aria-hidden="true">
                <span class="legend__end">La fila pierde</span>
                <span class="legend__ramp"></span>
                <span class="legend__end">La fila gana</span>
                <span class="legend__empty"><span class="legend__swatch"></span>Sin partidas</span>
              </div>
              <div class="matrix-wrap" id="matrix-wrap">
                <table class="matrix" id="matrix"></table>
              </div>
              <p class="empty" id="matrix-empty" hidden>Hacen falta al menos dos modelos en la liga.</p>
            </div>

            <div class="h2h__detail">
              <div class="pair-empty" id="pair-empty">
                <p class="pair-empty__title">Elige un cruce</p>
                <p class="section__hint">
                  Cada celda abre las partidas de esa pareja: de qué lado partió cada modelo, cómo terminó y con cuánta
                  vida.
                </p>
              </div>
              <section class="pair" id="pair" aria-labelledby="pair-title" hidden>
                <header class="pair__head">
                  <div>
                    <h3 class="pair__title" id="pair-title" tabindex="-1"></h3>
                    <p class="section__hint" id="pair-summary"></p>
                  </div>
                  <button type="button" class="btn btn--small" id="pair-close">Cerrar</button>
                </header>
                <div class="pair__body scroll-x" id="pair-body"></div>
              </section>
            </div>
          </div>
        </section>

        <!-- (5) Calibración y catálogo. -->
        <section class="section arena-section" aria-labelledby="calibration-title">
          <header class="section__head">
            <h2 class="section__title" id="calibration-title">Calibración</h2>
            <p class="section__hint" id="calibration-rule"></p>
          </header>
          <div class="scroll-x" id="calibration-table">
            <div class="axis axis--solo" id="calibration-axis-solo" aria-hidden="true"></div>
            <table class="board board--cards calib">
              <thead>
                <tr>
                  <th scope="col">Modelo</th>
                  <th scope="col" class="board__plothead">
                    <span class="sr-only">Diferencia con la referencia e intervalo en el eje</span>
                    <div class="axis" id="calibration-axis" aria-hidden="true"></div>
                  </th>
                  <th scope="col" class="num"><abbr title="Diferencia con la referencia ± error estándar, y el intervalo de decisión debajo">Diferencia</abbr></th>
                  <th scope="col" class="num">Partidas</th>
                  <th scope="col">Veredicto</th>
                  <th scope="col">Por qué</th>
                </tr>
              </thead>
              <tbody id="calibration-body"></tbody>
            </table>
          </div>
          <p class="empty" id="calibration-empty" hidden>Todavía no hay resultados de calibración.</p>
          <p class="board__note" id="catalog-meta"></p>

          <details class="omitted-box" id="omitted" hidden>
            <summary class="omitted__title" id="omitted-title"></summary>
            <ul class="omitted" id="omitted-list"></ul>
          </details>
        </section>
      </div>
    </main>

    <footer class="footer">
      <p>Hecho para la Platanus Hackathon 2026, track Simulaciones. Minecraft y agentes LLM.</p>
    </footer>

    <script>
      import "../scripts/arena/main";
    </script>
  </body>
</html>
