---
// Corazón de la barra de vida, píxel por píxel igual al del HUD de Minecraft (9x9):
// "container" es el casillero (contorno negro y fondo gris) y "full" el corazón rojo que
// va encima. Para retocarlos basta editar las filas (siempre 9 de 9 letras; "." es
// transparente).
interface Props {
  kind: "container" | "full";
}

const SPRITES = {
  container: {
    palette: { k: "#000000", g: "#282828" },
    rows: [
      "..kk.kk..",
      ".kggkggk.",
      "kgggggggk",
      "kgggggggk",
      "kgggggggk",
      ".kgggggk.",
      "..kgggk..",
      "...kgk...",
      "....k....",
    ],
  },
  full: {
    palette: { r: "#ff1313", w: "#ffc8c8", d: "#bb1313" },
    rows: [
      ".........",
      "..rr.rr..",
      ".rwrrrrr.",
      ".rrrrrrr.",
      ".drrrrrd.",
      "..drrrd..",
      "...drd...",
      "....d....",
      ".........",
    ],
  },
} satisfies Record<string, { palette: Record<string, string>; rows: string[] }>;

const sprite: { palette: Record<string, string>; rows: string[] } = SPRITES[Astro.props.kind];

// Los píxeles seguidos del mismo color de una fila se dibujan como un solo rectángulo.
const runs: { x: number; y: number; width: number; fill: string }[] = [];
sprite.rows.forEach((row, y) => {
  let x = 0;
  while (x < row.length) {
    const char = row[x]!;
    let end = x + 1;
    while (end < row.length && row[end] === char) end += 1;
    const fill = sprite.palette[char];
    if (fill) runs.push({ x, y, width: end - x, fill });
    x = end;
  }
});
---

<svg class="heart__sprite" viewBox="0 0 9 9" shape-rendering="crispEdges" aria-hidden="true">
  {runs.map((run) => <rect x={run.x} y={run.y} width={run.width} height="1" fill={run.fill} />)}
</svg>
