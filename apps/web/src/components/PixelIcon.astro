---
/**
 * Un ícono de píxeles dibujado al compilar la página. Los dibujos (y cómo retocarlos)
 * están en scripts/pixelicons.ts; los íconos que cambian en vivo los arma scripts/icons.ts
 * con esos mismos datos.
 */
import { ICON_SIZE, iconRuns, type IconName, type Material } from "../scripts/pixelicons";

interface Props {
  name: IconName;
  /** Solo para las formas que se tiñen (espada, armadura...): ver pixelicons.ts. */
  material?: Material;
}

const { name, material } = Astro.props;
const runs = iconRuns(name, material);
---

<svg
  class="pixel-icon"
  data-icon={name}
  viewBox={`0 0 ${ICON_SIZE} ${ICON_SIZE}`}
  shape-rendering="crispEdges"
  aria-hidden="true"
>
  {runs.map((run) => <rect x={run.x} y={run.y} width={run.width} height="1" fill={run.fill} />)}
</svg>
