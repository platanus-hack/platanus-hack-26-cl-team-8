---
/**
 * Íconos de píxeles para las estadísticas de cada agente, dibujados a mano en una
 * cuadrícula de 11x11 (no son texturas del juego, solo evocan su HUD):
 *
 *   food       muslo de carne, como la barra de hambre de Minecraft
 *   damage     espada de hierro en diagonal
 *   decisions  letrero de madera con dos flechas opuestas: elegir un camino
 *
 * Cada ícono es una lista de filas; cada letra es un color de su paleta y "." es
 * transparente. Para retocar un ícono basta editar las filas.
 */
type Icon = { palette: Record<string, string>; rows: string[] };

const OUTLINE = "#17120e";

const ICONS: Record<string, Icon> = {
  food: {
    palette: { k: OUTLINE, m: "#b96a34", l: "#e0a063", d: "#8a4821", b: "#f1e8d4" },
    rows: [
      ".....kkkk..",
      "....kmmmmk.",
      "...kmllmmmk",
      "...kmlmmmmk",
      "...kmmmmmdk",
      "...kmmmmddk",
      "..kbkmdddk.",
      ".kbbbkkkk..",
      "kbbbk......",
      "kbkbk......",
      ".k.k.......",
    ],
  },
  damage: {
    palette: { k: OUTLINE, w: "#eef1f5", s: "#9ea9b8", g: "#5d6675", h: "#99632f" },
    rows: [
      "........kkk",
      ".......kwwk",
      "......kwwsk",
      ".kk..kwwsk.",
      ".kgkkwwsk..",
      "..kgwwsk...",
      "..kkgsk....",
      "..khkgkk...",
      ".khhkkgk...",
      "khhk..kk...",
      "kkk........",
    ],
  },
  decisions: {
    palette: { k: OUTLINE, o: "#d2a468", s: "#a97c44", p: "#7b5730" },
    rows: [
      "....kkk....",
      "..kkkpkkk..",
      "..kooooook.",
      "..koooooook",
      "..kssssssk.",
      ".kkkkpkkk..",
      ".kooooook..",
      "koooooook..",
      ".kssssssk..",
      "..kkkpkkk..",
      "....kkk....",
    ],
  },
};

interface Props {
  name: keyof typeof ICONS;
}

const icon = ICONS[Astro.props.name]!;
const size = icon.rows.length;

// Une los píxeles consecutivos del mismo color en un solo rectángulo por tramo.
const runs: { x: number; y: number; width: number; fill: string }[] = [];
icon.rows.forEach((row, y) => {
  let x = 0;
  while (x < row.length) {
    const char = row[x]!;
    let end = x + 1;
    while (end < row.length && row[end] === char) end += 1;
    const fill = icon.palette[char];
    if (fill) runs.push({ x, y, width: end - x, fill });
    x = end;
  }
});
---

<svg class="pixel-icon" viewBox={`0 0 ${size} ${size}`} shape-rendering="crispEdges" aria-hidden="true">
  {runs.map((run) => <rect x={run.x} y={run.y} width={run.width} height="1" fill={run.fill} />)}
</svg>
